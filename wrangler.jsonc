{
  "name": "portal-ena-rym",
  "compatibility_date": "2026-08-27",
  "main": "worker.js",
  "build": {
    "command": "cd vue && npm install --no-audit --no-fund && npm run build"
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/"]
  }
}
